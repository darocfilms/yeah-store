# Copia este archivo a .env para desarrollo local con `netlify dev`.
# En producción, configura estas mismas variables en:
# Netlify → Site configuration → Environment variables.
# Ver DEPLOY.md para instrucciones detalladas de cada una.

# URL pública del sitio ya desplegado (sin barra final). Se usa para armar
# success_url / cancel_url / webhooks. Ej: https://yeah-store.netlify.app
SITE_URL=

# ---------- Stripe ----------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks — firma del endpoint stripe-webhook
STRIPE_WEBHOOK_SECRET=

# ---------- MercadoPago ----------
# https://www.mercadopago.cl/developers/panel/app → Credenciales de producción
MP_ACCESS_TOKEN=

# Token compartido que protege TODOS los endpoints de administración:
#   list-mp-payments      → consultar pagos
#   admin-subir-producto  → subir el .zip que se vende
#   admin-entregar        → liberar una entrega manualmente (transferencias)
# Nunca lo dejes vacío en producción. Genera uno con: openssl rand -hex 24
ADMIN_TOKEN=

# ---------- Cuenta de administración ----------
# El correo que manda en la tienda: es el único que recibe el rol admin y
# nadie más puede registrarlo desde el formulario público.
ADMIN_EMAIL=darocfilms@gmail.com

# Contraseña con la que se crea la cuenta de administración la PRIMERA vez que
# se inicia sesión con ADMIN_EMAIL. Después de ese primer ingreso la cuenta ya
# existe y esta variable deja de tener efecto: la contraseña se cambia desde
# "Mi cuenta → Cambiar contraseña". Conviene borrarla de Netlify una vez usada.
ADMIN_INITIAL_PASSWORD=

# ---------- PayPal ----------
# https://developer.paypal.com/dashboard/applications → tu app REST
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" para cobrar de verdad, cualquier otro valor (o vacío) usa sandbox
PAYPAL_ENV=sandbox

# La tienda cobra en CLP, pero PayPal no acepta CLP: ese método cobra el
# equivalente en USD usando esta tasa fija. Actualízala periódicamente.
# Si no se define, el código usa 936.
USD_CLP_RATE=936

# ---------- Email de entrega (Resend) ----------
# https://resend.com/api-keys
RESEND_API_KEY=
# Remitente — debe ser de un dominio verificado en Resend
EMAIL_FROM="YEAH! <pedidos@tudominio.com>"
# A quién le llegan las notificaciones de venta / pedidos pendientes
STORE_NOTIFY_EMAIL=darocfilms@gmail.com
